fbf4c8996fb92427ae41e4649b934ca495991b7852b855","size":0},{"path":"_internal/cryptography-50.0.2.dist-info/WHEEL","sha256":"9efe56059dbb731c438c822ac4132a2b670e174db90f09059aa246a8bdd2a575","size":96},{"path":"_internal/cryptography/hazmat/bindings/_rust.pyd","sha256":"1d4332a447cab13dec8e3a533ad579e0e562b79e40822c931f33769758fc7156","size":9897472},{"path":"_internal/cryptography-50.0.2.dist-info/licenses/LICENSE","sha256":"3e0c7c091a948b82533ba98fd7cbb40432d6f1a9acbf85f5922d2f99a93ae6bb","size":197},{"path":"_internal/cryptography-50.0.2.dist-info/licenses/LICENSE.APACHE","sha256":"aac73b3148f6d1d7111dbca32099f68d26c644c6813ae1e4f05f6579aa2663fe","size":11360},{"path":"_internal/cryptography-50.0.2.dist-info/licenses/LICENSE.BSD","sha256":"602c4c7482de6479dd2e9793cda275e5e63d773dacd1eca689232ab7008fb4fb","size":1532},{"path":"_internal/cryptography-50.0.2.dist-info/sboms/cryptography-rust.cyclonedx.json","sha256":"246af194b4c524807c5aaffd2b7ff86c2c9bee3eb3fceeac987709ad76e4e7ef","size":45629},{"path":"_internal/cryptography-50.0.2.dist-info/sboms/sbom.json","sha256":"5b5eea08dd952a16eef188f7a85ad439a4409efa0e2bce9ca339a4de9c8db3f0","size":1223}],"mandatory":false,"minimum_version":"0.64.0","notes":["업데이트 설치파일과 서명된 버전정보를 GitHub 배포 저장소에서 받습니다. 오류 로그 전송과 수신 알리미는 기존 Cloudflare 방식을 유지합니다.","정해진 GitHub 저장소와 해당 릴리스의 다운로드 서버만 허용하며, 배포 서명·전체 파일 해시·이어받기·현재 버전 사용과 자동 설치 후 재시작 검증을 유지합니다.","1103_8뉴스 같은 파일명 날짜를 화면 연도로 인식하고 분석 전에 해당 날짜·프로그램의 큐시트를 확인합니다. 직접 입력한 날짜는 보존합니다.","스포츠 연결 뒤 자체 기타·날씨가 복귀하면 별도 꼭지로 지정합니다. 풀영상은 기존 뉴스 끝을 유지하며 스포츠·광고를 이어 붙이지 않습니다.","기존 날씨 조각을 올바른 큐시트 번호에 먼저 연결해 중복 생성을 막고, 본뉴스 종료와 복귀 꼭지의 광고 이전 종료를 각각 검증합니다. 로고는 방송 소속 판단에 사용하지 않습니다.","업데이트가 중단되면 받은 부분을 보관하고 이어받습니다. 정상 수신 중 누적 5분만으로 취소하지 않으며 연속 30초 무수신 시 최대 3회 재연결합니다.","다운로드·파일 확인 중 현재 버전 사용을 선택할 수 있습니다. 같은 실행에서 예약 설치를 취소하고 다음 업데이트 확인 때 이어받습니다.","분석 엔진·기존 정상 경계·수동 경계·썸네일·설정·작업기록을 그대로 유지합니다. 이번 업데이트 경로 변경 때문에 영상을 재분석할 필요는 없습니다."],"platform":"windows-x64","published_at":"2026-11-04T13:23:06.155833+00:00","schema":1,"sha256":"f4709056b5b5aeb5eb191117d6ee086c9adeb106d7201f50b6fbd73e1f3b060b","size":31532531,"url":"https://github.com/hmh1644/g1-news-editor-updates/releases/download/v0.86.0/G1NewsEditor_Alpha_0.86.0_Update_Setup.exe","version":"0.86.0"},"schema":1,"signature":"6bePJGhtQYZvovme8nzzqQ+lJzP4dqloN51wb6hr/boFuGCLdDi7oERiUiRsHspi5FXHsi/qBZr/mThzC3+JDQ=="}